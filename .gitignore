# ==============================================================================
# Metron Monorepo Git Ignore Rules
# ==============================================================================

# Node & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Expo & Mobile
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo

# Native Builds (if generated locally via prebuild)
mobile/android/
mobile/ios/
.kotlin/

# Mobile Signing Keys & Credentials
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Environment Variables & Secrets
.env
.env*.local
!.env.example

# Operating System & IDE Files
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
